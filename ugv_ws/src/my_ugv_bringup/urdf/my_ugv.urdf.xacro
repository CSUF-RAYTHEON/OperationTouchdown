<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="viet_rover">

    <xacro:property name="base_length" value="0.762"/> 
    <xacro:property name="base_width"  value="0.610"/> 
    <xacro:property name="base_height" value="0.200"/> 

    <xacro:property name="wheel_radius" value="0.165"/> 
    <xacro:property name="laser_x" value="0.095"/> 
    <xacro:property name="laser_y" value="0.038"/> 
    <xacro:property name="laser_z" value="0.569"/> 
    <xacro:property name="cam_x" value="0.089"/> 
    <xacro:property name="cam_y" value="-0.012"/> 
    <xacro:property name="cam_z" value="0.241"/> 

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
            <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
        </visual>
        <collision>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
        </collision>
    </link>

    <link name="laser">
        <visual>
            <geometry><cylinder radius="0.035" length="0.04"/></geometry>
            <material name="black"><color rgba="0 0 0 1"/></material>
        </visual>
        <collision>
            <geometry><cylinder radius="0.035" length="0.04"/></geometry>
        </collision>
    </link>

    <link name="oak-d-base-frame"/>
    <link name="oak_rgb_camera_frame"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser"/>
        <origin xyz="${laser_x} ${laser_y} ${laser_z - wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="oak-d-base-frame"/>
    <origin xyz="0.15 0.0 0.05" rpy="0 -1.57 0"/> 
    </joint>

    <joint name="oak_base_to_rgb" type="fixed">
        <parent link="oak-d-base-frame"/>
        <child link="oak_rgb_camera_frame"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</robot>